{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monadbox",
  "main": "dist/worker/index.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monadbox-production",
      "database_id": "37b5d014-4297-40b4-aa3c-4d1a1471dcb0",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "CHAIN_ID": "10143",
    "STORAGE_NAMESPACE": "monadbox-production",
    "STORAGE_ENABLED": "false",
    "BACKGROUND_ENABLED": "false",
    "NETWORK_WRITES_ENABLED": "false",
    "MAINNET_ENABLED": "false",
    "ASSET_ALLOWLIST": "[]",
    "CONTRACT_REGISTRY": "[]",
    "TESTNET_LAB_ENABLED": "false",
    "CLOUD_ENABLED": "true",
    "ATTACHMENTS_ENABLED": "false",
    "GROUP_PUBLISH_ENABLED": "false",
    "GROUP_DEPLOYMENT": "null",
    "APP_ORIGIN": "https://monadbox.iwbinb.workers.dev",
    "MODULES_ENABLED": "true",
    "MODULE_PUBLISH_ENABLED": "false",
    "MODULE_DEPLOYMENTS": "[]"
  }
}
