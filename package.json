{
  "name": "monadbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "dependencies": {
    "hono": "4.13.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260927.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "miniflare": "5.20260925.0-alpha",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wrangler": "4.135.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && wrangler dev --config wrangler.local.jsonc --port 8787",
    "build": "node scripts/build.mjs",
    "lint": "eslint src tests scripts *.ts *.mjs",
    "format": "prettier --write --ignore-unknown src tests scripts *.ts *.mjs *.json *.jsonc *.html .github/workflows",
    "format:check": "prettier --check --ignore-unknown src tests scripts *.ts *.mjs *.json *.jsonc *.html .github/workflows",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:config": "node scripts/validate-config.mjs",
    "deploy": "node scripts/deploy.mjs production",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir artifacts/worker-dry-run"
  }
}
